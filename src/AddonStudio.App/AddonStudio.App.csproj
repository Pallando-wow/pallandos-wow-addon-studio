<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.11</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="ClassIsland.Markdown.Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AddonStudio.Core\AddonStudio.Core.csproj" />
    <ProjectReference Include="..\AddonStudio.Application\AddonStudio.Application.csproj" />
    <ProjectReference Include="..\AddonStudio.Data\AddonStudio.Data.csproj" />
    <ProjectReference Include="..\AddonStudio.Wow\AddonStudio.Wow.csproj" />
    <ProjectReference Include="..\AddonStudio.Git\AddonStudio.Git.csproj" />
    <ProjectReference Include="..\AddonStudio.Media\AddonStudio.Media.csproj" />
    <ProjectReference Include="..\AddonStudio.Packaging\AddonStudio.Packaging.csproj" />
    <ProjectReference Include="..\AddonStudio.Platforms\AddonStudio.Platforms.csproj" />
  </ItemGroup>
</Project>
