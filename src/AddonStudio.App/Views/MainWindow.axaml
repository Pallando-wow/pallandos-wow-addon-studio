<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AddonStudio.App.ViewModels"
        xmlns:projects="using:AddonStudio.Application.Projects"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="AddonStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="650"
        Icon="/Assets/avalonia-logo.ico"
        Title="Pallando's WoW Addon Studio">

    <Grid RowDefinitions="44,*,28">
        <Border Grid.Row="0"
                Padding="14,0"
                BorderThickness="0,0,0,1"
                BorderBrush="#353535">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="14">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Pallando's WoW Addon Studio" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <Button Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding IsSetupComplete}"
                            Command="{Binding OpenCreateAddonCommand}"
                            ToolTip.Tip="New Addon">
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="M7,11 L11,11 L11,7 L13,7 L13,11 L17,11 L17,13 L13,13 L13,17 L11,17 L11,13 L7,13 Z" />
                    </Button>
                    <Button Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding IsSetupComplete}"
                            Command="{Binding OpenImportAddonCommand}"
                            ToolTip.Tip="Import Existing Addon">
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="M11,5 L13,5 L13,13 L16.5,9.5 L18,11 L12,17 L6,11 L7.5,9.5 L11,13 Z M6,18 L18,18 L18,20 L6,20 Z" />
                    </Button>
                    <Button Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding IsSetupComplete}"
                            Command="{Binding OpenCollectorImportCommand}"
                            ToolTip.Tip="Import Collector Data">
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="F0 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 12,18 A6,6 0 1 0 12,6 Z M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <TextBlock Opacity="0.65"
                               Text="WoW Forever" />
                    <TextBlock Opacity="0.45"
                               Text="{Binding StudioVersion}"
                               ToolTip.Tip="Studio version" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="56,270,4,*">
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#353535">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                      Margin="0,8">
                    <Button Grid.Row="0"
                            Width="44"
                            Height="44"
                            Padding="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,2"
                            IsEnabled="{Binding IsSetupComplete}"
                            Command="{Binding ShowStartCommand}"
                            ToolTip.Tip="Start">
                        <PathIcon Width="20"
                                  Height="20"
                                  Data="M3,11 L12,3 L21,11 L19,11 L19,20 L14,20 L14,14 L10,14 L10,20 L5,20 L5,11 Z" />
                    </Button>

                    <Button Grid.Row="1"
                            Width="44"
                            Height="44"
                            Padding="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,2"
                            IsEnabled="{Binding HasCurrentProject}"
                            Command="{Binding ShowProjectOverviewCommand}"
                            ToolTip.Tip="Current project">
                        <PathIcon Width="20"
                                  Height="20"
                                  Data="M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z" />
                    </Button>

                    <Button Grid.Row="2"
                            Width="44"
                            Height="44"
                            Padding="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,2"
                            IsEnabled="{Binding IsSetupComplete}"
                            Command="{Binding ShowComponentsCommand}"
                            ToolTip.Tip="Components">
                        <PathIcon Width="20"
                                  Height="20"
                                  Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
                    </Button>

                    <Button Grid.Row="4"
                            Width="44"
                            Height="44"
                            Padding="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,2"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="Settings">
                        <PathIcon Width="20"
                                  Height="20"
                                  Data="M4,6 L10,6 L10,8 L4,8 Z M14,6 L20,6 L20,8 L14,8 Z M11,4 L13,4 L13,10 L11,10 Z M4,11 L6,11 L6,17 L4,17 Z M10,13 L20,13 L20,15 L10,15 Z M7,11 L9,11 L9,17 L7,17 Z M4,20 L14,20 L14,22 L4,22 Z M18,18 L20,18 L20,22 L18,22 Z M15,19 L18,19 L18,21 L15,21 Z" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="14"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#353535">
                <Grid>
                    <StackPanel IsVisible="{Binding IsStartSidebar}"
                                Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       Text="PROJECTS" />
                            <Button Grid.Column="1"
                                    Padding="8,3"
                                    Click="RefreshProjects_Click"
                                    Content="↻"
                                    ToolTip.Tip="Refresh projects" />
                        </Grid>

                        <TextBlock IsVisible="{Binding HasNoProjects}"
                                   TextWrapping="Wrap"
                                   Opacity="0.65"
                                   Text="No managed Studio projects were found below the configured project root." />

                        <ListBox IsVisible="{Binding HasProjects}"
                                 ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject}"
                                 MaxHeight="420">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="projects:ProjectCatalogEntry">
                                    <StackPanel Margin="2,4"
                                                Spacing="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <TextBlock FontSize="11"
                                                   Opacity="0.6"
                                                   Text="{Binding TypeName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding HasUnmanagedFolders}"
                                    Spacing="6"
                                    Margin="0,8,0,0">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       Text="UNMANAGED FOLDERS" />
                            <ItemsControl ItemsSource="{Binding UnmanagedFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:UnmanagedProjectFolder">
                                        <StackPanel Margin="0,3"
                                                    Spacing="1">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       Opacity="0.65"
                                                       Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Text="These folders are not managed Studio projects. Keep source projects outside the global project root and use Import Existing Addon." />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasProjectCatalogIssues}"
                                    Spacing="5"
                                    Margin="0,8,0,0">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       Text="SKIPPED PROJECTS" />
                            <ItemsControl ItemsSource="{Binding ProjectCatalogIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2"
                                                   FontSize="11"
                                                   Opacity="0.65"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsProjectSidebar}"
                                Spacing="8">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Text="PROJECT" />

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentProjectName}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <TextBlock FontSize="11"
                                       Opacity="0.6"
                                       Text="{Binding CurrentProjectTypeName}" />
                            <TextBlock FontSize="11"
                                       Opacity="0.6"
                                       Text="{Binding CurrentPrimaryAddon}" />
                        </StackPanel>

                        <Separator Margin="0,4" />

                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowProjectOverviewCommand}"
                                Content="Overview" />
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowExplorerCommand}"
                                Content="Files" />
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowPublishingCommand}"
                                Content="Publishing" />

                        <StackPanel IsVisible="{Binding IsPublishingSidebar}"
                                    Margin="12,0,0,2"
                                    Spacing="3">
                            <Button Padding="10,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="PublishingSummarySection_Click"
                                    Content="Summary" />
                            <Button Padding="10,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="PublishingDescriptionSection_Click"
                                    Content="Description" />
                            <Button Padding="10,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="PublishingMediaSection_Click"
                                    Content="Media" />
                            <Button Padding="10,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="PublishingCurrentReleaseSection_Click"
                                    Content="Current Release" />
                        </StackPanel>

                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowCurseForgeCommand}"
                                Content="CurseForge" />
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ShowGitCommand}"
                                Content="Git" />

                        <StackPanel IsVisible="{Binding IsExplorerSidebar}"
                                    Spacing="7"
                                    Margin="0,6,0,0">
                            <Separator />
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Opacity="0.75"
                                       Text="FILES" />

                            <TreeView ItemsSource="{Binding CurrentProjectTree}"
                                      SelectedItem="{Binding SelectedProjectTreeItem}"
                                      DoubleTapped="ProjectTree_DoubleTapped">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="projects:ProjectTreeItem"
                                                      ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}" />
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsComponentsSidebar}"
                                Spacing="10">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Text="COMPONENTS" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.65"
                                   Text="Libraries, UI components and asset packs will be managed here." />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSettingsSidebar}"
                                Spacing="10">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Text="SETTINGS" />
                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.65"
                                   Text="Global project root, WoW Forever path and Studio preferences." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          ResizeDirection="Columns"
                          Background="#2A2A2A" />

            <Grid Grid.Column="3"
                  RowDefinitions="*,4,170">
                <TabControl Grid.Row="0"
                            SelectedIndex="{Binding WorkspaceTabIndex}">
                    <TabItem Header="{Binding WorkspaceTitle}">
                        <Grid>
                            <ScrollViewer IsVisible="{Binding IsSettingsSidebar}">
                                <StackPanel Margin="32"
                                            MaxWidth="820"
                                            HorizontalAlignment="Left"
                                            Spacing="22">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Text="Settings" />
                                        <TextBlock IsVisible="{Binding SetupRequired}"
                                                   FontSize="15"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap"
                                                   Text="Initial setup is required before you can create, import or work with projects." />
                                    </StackPanel>

                                    <Border Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="14">
                                            <TextBlock FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="Project locations" />

                                            <TextBlock Text="Global project root" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="New and imported Studio projects are stored below this directory." />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Grid.Column="0"
                                                         IsReadOnly="True"
                                                         Text="{Binding ProjectRoot}"
                                                         PlaceholderText="Select a project root ..." />
                                                <Button Grid.Column="1"
                                                        Click="ChooseProjectRoot_Click"
                                                        Content="Browse ..." />
                                            </Grid>

                                            <TextBlock Margin="0,8,0,0"
                                                       Text="WoW Forever AddOns path" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="Select the InterfaceAddOns directory used as the deploy and test target." />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Grid.Column="0"
                                                         IsReadOnly="True"
                                                         Text="{Binding WowForeverAddOnsPath}"
                                                         PlaceholderText="Select the WoW Forever AddOns folder ..." />
                                                <Button Grid.Column="1"
                                                        Click="ChooseWowAddOnsPath_Click"
                                                        Content="Browse ..." />
                                            </Grid>

                                            <TextBlock Margin="0,8,0,0"
                                                       Text="WoW SavedVariables path" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="Optional. Select the SavedVariables folder that contains PallandoDataCollector.lua. Collector Data will then use this file automatically." />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Grid.Column="0"
                                                         IsReadOnly="True"
                                                         Text="{Binding SavedVariablesPath}"
                                                         PlaceholderText="Select the SavedVariables folder ..." />
                                                <Button Grid.Column="1"
                                                        Click="ChooseSavedVariablesPath_Click"
                                                        Content="Browse ..." />
                                            </Grid>

                                            <StackPanel Margin="0,10,0,0"
                                                        Orientation="Horizontal"
                                                        Spacing="10">
                                                <Button Click="SaveSettings_Click"
                                                        Content="Save settings" />
                                                <Button Click="ResetSettings_Click"
                                                        Content="Reset settings"
                                                        ToolTip.Tip="Delete the saved Studio settings and return to initial setup." />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="12">
                                            <TextBlock FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="CurseForge data source" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="The API key is stored locally and protected for the current Windows user. CurseForge project features stay restricted until the data source connects successfully." />
                                            <TextBlock Text="API key" />
                                            <TextBox Text="{Binding CurseForgeApiKey}"
                                                     PasswordChar="●"
                                                     Watermark="Enter CurseForge API key ..." />
                                            <TextBlock FontSize="11"
                                                       Opacity="0.65"
                                                       Text="{Binding CurseForgeApiKeyStorageStatus}" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10">
                                                <Button IsEnabled="{Binding CanSaveCurseForgeApiKey}"
                                                        Command="{Binding SaveCurseForgeApiKeyCommand}"
                                                        Content="Save API key" />
                                                <Button Command="{Binding TestCurseForgeDataSourceCommand}"
                                                        Content="Test connection" />
                                                <TextBlock VerticalAlignment="Center"
                                                           Opacity="0.7"
                                                           Text="{Binding CurseForgeDataSourceStatus}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid IsVisible="{Binding IsStartSidebar}">
                                <ScrollViewer IsVisible="{Binding HasNoSelectedProject}">
                                    <StackPanel Margin="32"
                                            MaxWidth="920"
                                            HorizontalAlignment="Left"
                                            Spacing="24">
                                    <Grid ColumnDefinitions="128,*"
                                          ColumnSpacing="22">
                                        <Image Grid.Column="0"
                                               Width="128"
                                               Height="128"
                                               Stretch="Uniform"
                                               Source="/Assets/pallando-studio-logo.png" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="6">
                                            <TextBlock FontSize="28"
                                                       FontWeight="SemiBold"
                                                       Text="WoW Addon Studio" />
                                            <TextBlock FontSize="15"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       Text="Develop, validate, deploy and publish addons exclusively for WoW Forever." />
                                        </StackPanel>
                                    </Grid>

                                    <Border Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="14">
                                            <TextBlock FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="Workspace overview" />

                                            <Grid ColumnDefinitions="*,*,*"
                                                  ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        Padding="14"
                                                        CornerRadius="6"
                                                        Background="#16000000">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding ManagedProjectCount}" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Managed projects" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Padding="14"
                                                        CornerRadius="6"
                                                        Background="#16000000">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding RuntimeAddonCount}" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Runtime addons" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Padding="14"
                                                        CornerRadius="6"
                                                        Background="#16000000">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontSize="24"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding UnmanagedFolderCount}" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Unmanaged folders" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <TextBlock TextWrapping="Wrap"
                                                       Opacity="0.65"
                                                       Text="Select a project in the left sidebar to preview it. Create and import actions are available from the toolbar above." />
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding HasNoProjects}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="No Studio projects yet" />
                                            <TextBlock Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="Use the New Addon or Import Existing Addon buttons in the toolbar to add your first managed project." />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer IsVisible="{Binding HasSelectedProject}">
                                    <StackPanel Margin="32"
                                                MaxWidth="920"
                                                HorizontalAlignment="Left"
                                                Spacing="20">
                                        <TextBlock FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SelectedProjectName}" />
                                        <TextBlock FontSize="14"
                                                   Opacity="0.7"
                                                   Text="Project preview" />

                                        <Border Padding="20"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="180,*"
                                                  ColumnSpacing="18"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0"
                                                           FontWeight="SemiBold"
                                                           Text="Type" />
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding SelectedProjectTypeName}" />

                                                <TextBlock Grid.Row="1"
                                                           FontWeight="SemiBold"
                                                           Text="Primary addon" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding SelectedProjectPrimaryAddon}" />

                                                <TextBlock Grid.Row="2"
                                                           FontWeight="SemiBold"
                                                           Text="Runtime addons" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding SelectedProjectRuntimeAddons}" />

                                                <TextBlock Grid.Row="3"
                                                           FontWeight="SemiBold"
                                                           Text="Components" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding SelectedProjectComponents}" />

                                                <TextBlock Grid.Row="4"
                                                           FontWeight="SemiBold"
                                                           Text="Release package" />
                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="1"
                                                           Text="{Binding SelectedProjectPackageName}" />

                                                <TextBlock Grid.Row="5"
                                                           FontWeight="SemiBold"
                                                           Text="CurseForge" />
                                                <TextBlock Grid.Row="5"
                                                           Grid.Column="1"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding SelectedProjectCurseForge}" />

                                                <TextBlock Grid.Row="6"
                                                           FontWeight="SemiBold"
                                                           Text="Project directory" />
                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="1"
                                                           TextWrapping="Wrap"
                                                           Opacity="0.7"
                                                           Text="{Binding SelectedProjectDirectory}" />

                                                <Button Grid.Row="7"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        IsEnabled="{Binding CanOpenSelectedProject}"
                                                        Click="OpenSelectedProject_Click"
                                                        Content="Open Project" />
                                            </Grid>
                                        </Border>

                                        <Border IsVisible="{Binding HasSelectedProjectTocMetadata}"
                                                Padding="20"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="12">
                                                <TextBlock FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Text="Addon metadata (.toc)" />

                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                      ColumnDefinitions="180,*"
                                                      ColumnSpacing="18"
                                                      RowSpacing="8">
                                                    <TextBlock Grid.Row="0"
                                                               FontWeight="SemiBold"
                                                               Text="TOC file" />
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding SelectedProjectTocFile}" />

                                                    <TextBlock Grid.Row="1"
                                                               FontWeight="SemiBold"
                                                               Text="Title" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding SelectedProjectTocTitle}" />

                                                    <TextBlock Grid.Row="2"
                                                               FontWeight="SemiBold"
                                                               Text="Version" />
                                                    <TextBlock Grid.Row="2"
                                                               Grid.Column="1"
                                                               Text="{Binding SelectedProjectTocVersion}" />

                                                    <TextBlock Grid.Row="3"
                                                               FontWeight="SemiBold"
                                                               Text="Author" />
                                                    <TextBlock Grid.Row="3"
                                                               Grid.Column="1"
                                                               Text="{Binding SelectedProjectTocAuthor}" />

                                                    <TextBlock Grid.Row="4"
                                                               FontWeight="SemiBold"
                                                               Text="Interface" />
                                                    <TextBlock Grid.Row="4"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding SelectedProjectTocInterfaces}" />

                                                    <TextBlock Grid.Row="5"
                                                               FontWeight="SemiBold"
                                                               Text="Notes" />
                                                    <TextBlock Grid.Row="5"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding SelectedProjectTocNotes}" />

                                                    <TextBlock Grid.Row="6"
                                                               FontWeight="SemiBold"
                                                               Text="Dependencies" />
                                                    <TextBlock Grid.Row="6"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding SelectedProjectTocDependencies}" />

                                                    <TextBlock Grid.Row="7"
                                                               FontWeight="SemiBold"
                                                               Text="Saved variables" />
                                                    <TextBlock Grid.Row="7"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding SelectedProjectTocSavedVariables}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border IsVisible="{Binding HasSelectedProjectSummary}"
                                                Padding="20"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="10">
                                                <TextBlock FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Text="Summary" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Opacity="0.85"
                                                           Text="{Binding SelectedProjectSummary}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <ScrollViewer IsVisible="{Binding IsProjectOverviewSidebar}">
                                <StackPanel Margin="32"
                                            MaxWidth="1480"
                                            HorizontalAlignment="Left"
                                            Spacing="20">
                                    <Border Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <Grid ColumnDefinitions="170,*,Auto"
                                              ColumnSpacing="22">
                                            <StackPanel Grid.Column="0"
                                                        Spacing="10">
                                                <Border Width="160"
                                                        Height="160"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="#3A3A3A"
                                                        Background="#10000000">
                                                    <Grid>
                                                        <Image IsVisible="{Binding HasCurrentProjectLogoImage}"
                                                               Margin="8"
                                                               Stretch="Uniform"
                                                               Source="{Binding CurrentProjectLogoImage}" />
                                                        <StackPanel IsVisible="{Binding HasNoCurrentProjectLogoImage}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="5">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Text="No logo" />
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       FontSize="11"
                                                                       Opacity="0.6"
                                                                       Text="Media/Logo/logo.png" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Button HorizontalAlignment="Stretch"
                                                        Click="ChoosePublishingLogo_Click"
                                                        Content="{Binding PublishingLogoActionText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="10">
                                                <TextBlock FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding CurrentProjectName}" />

                                                <TextBlock IsVisible="{Binding HasSelectedProjectSummary}"
                                                           MaxWidth="720"
                                                           FontSize="14"
                                                           Opacity="0.8"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding SelectedProjectSummary}" />

                                                <Grid Margin="0,6,0,0"
                                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                      ColumnDefinitions="120,*"
                                                      ColumnSpacing="16"
                                                      RowSpacing="6">
                                                    <TextBlock Grid.Row="0"
                                                               Opacity="0.65"
                                                               Text="Version" />
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ProjectDashboardVersion}" />

                                                    <TextBlock Grid.Row="1"
                                                               Opacity="0.65"
                                                               Text="Author" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="{Binding ProjectDashboardAuthor}" />

                                                    <TextBlock Grid.Row="2"
                                                               Opacity="0.65"
                                                               Text="Interface" />
                                                    <TextBlock Grid.Row="2"
                                                               Grid.Column="1"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding ProjectDashboardInterfaces}" />

                                                    <TextBlock Grid.Row="3"
                                                               Opacity="0.65"
                                                               Text="Primary addon" />
                                                    <TextBlock Grid.Row="3"
                                                               Grid.Column="1"
                                                               Text="{Binding CurrentPrimaryAddon}" />

                                                    <TextBlock Grid.Row="4"
                                                               Opacity="0.65"
                                                               Text="Type" />
                                                    <TextBlock Grid.Row="4"
                                                               Grid.Column="1"
                                                               Text="{Binding CurrentProjectTypeName}" />
                                                </Grid>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    MinWidth="140"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding InstallForTestingCommand}"
                                                    Content="Addon installieren"
                                                    ToolTip.Tip="Aktuelles Addon für den Test in WoW installieren" />
                                        </Grid>
                                    </Border>

                                    <WrapPanel Orientation="Horizontal">
                                        <StackPanel Width="760"
                                                    Margin="0,0,20,16"
                                                    Spacing="14">
                                            <Grid ColumnDefinitions="*,*"
                                                  ColumnSpacing="14">
                                                <Border Grid.Column="0"
                                                        Padding="18"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="#3A3A3A">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="19"
                                                                       FontWeight="SemiBold"
                                                                       Text="Publishing" />
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding ShowPublishingCommand}"
                                                                    Content="Open" />
                                                        </Grid>

                                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                              ColumnDefinitions="130,*"
                                                              ColumnSpacing="12"
                                                              RowSpacing="7">
                                                            <TextBlock Grid.Row="0"
                                                                       Text="Summary" />
                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="1"
                                                                       Text="{Binding PublishingSummaryStatus}" />

                                                            <TextBlock Grid.Row="1"
                                                                       Text="Description" />
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.Column="1"
                                                                       Text="{Binding PublishingDescriptionStatus}" />

                                                            <TextBlock Grid.Row="2"
                                                                       Text="Changelog" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="1"
                                                                       Text="{Binding PublishingChangelogStatus}" />

                                                            <TextBlock Grid.Row="3"
                                                                       Text="Logo" />
                                                            <TextBlock Grid.Row="3"
                                                                       Grid.Column="1"
                                                                       Text="{Binding PublishingLogoStatus}" />

                                                            <TextBlock Grid.Row="4"
                                                                       Text="Screenshots" />
                                                            <TextBlock Grid.Row="4"
                                                                       Grid.Column="1"
                                                                       Text="{Binding PublishingScreenshotsStatus}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Padding="18"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="#3A3A3A">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="19"
                                                                       FontWeight="SemiBold"
                                                                       Text="CurseForge" />
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding ShowCurseForgeCommand}"
                                                                    Content="Open" />
                                                        </Grid>

                                                        <Grid RowDefinitions="Auto,Auto"
                                                              ColumnDefinitions="130,*"
                                                              ColumnSpacing="12"
                                                              RowSpacing="7">
                                                            <TextBlock Grid.Row="0"
                                                                       Text="Data source" />
                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="1"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding CurseForgeDataSourceStatus}" />

                                                            <TextBlock Grid.Row="1"
                                                                       Text="Project" />
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.Column="1"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding ProjectDashboardCurseForgeStatus}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Padding="18"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="#3A3A3A">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   FontSize="19"
                                                                   FontWeight="SemiBold"
                                                                   Text="Project" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding ShowExplorerCommand}"
                                                                Content="Open Files" />
                                                    </Grid>

                                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                                          ColumnDefinitions="150,*"
                                                          ColumnSpacing="16"
                                                          RowSpacing="8">
                                                        <TextBlock Grid.Row="0"
                                                                   Text="Runtime addons" />
                                                        <ItemsControl Grid.Row="0"
                                                                      Grid.Column="1"
                                                                      ItemsSource="{Binding CurrentRuntimeAddons}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="Components" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding ProjectDashboardComponents}" />

                                                        <TextBlock Grid.Row="2"
                                                                   Text="Project directory" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   Opacity="0.7"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding CurrentProjectDirectory}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border IsVisible="{Binding HasSelectedProjectTocMetadata}"
                                                    Padding="18"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="#3A3A3A">
                                                <StackPanel Spacing="12">
                                                    <TextBlock FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Text="Addon metadata (.toc)" />

                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                          ColumnDefinitions="150,*"
                                                          ColumnSpacing="16"
                                                          RowSpacing="8">
                                                        <TextBlock Grid.Row="0"
                                                                   Text="TOC file" />
                                                        <TextBlock Grid.Row="0"
                                                                   Grid.Column="1"
                                                                   Text="{Binding SelectedProjectTocFile}" />

                                                        <TextBlock Grid.Row="1"
                                                                   Text="Notes" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding SelectedProjectTocNotes}" />

                                                        <TextBlock Grid.Row="2"
                                                                   Text="Dependencies" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding SelectedProjectTocDependencies}" />

                                                        <TextBlock Grid.Row="3"
                                                                   Text="Saved variables" />
                                                        <TextBlock Grid.Row="3"
                                                                   Grid.Column="1"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding SelectedProjectTocSavedVariables}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>

                                        <Border Width="640"
                                                MinHeight="620"
                                                Margin="0,0,0,16"
                                                Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="3">
                                                        <TextBlock FontSize="19"
                                                                   FontWeight="SemiBold"
                                                                   Text="Screenshots" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="{Binding PublishingScreenshotsStatus}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Click="AddPublishingScreenshots_Click"
                                                            Content="Add" />
                                                </Grid>

                                                <Border IsVisible="{Binding HasNoProjectScreenshots}"
                                                        Height="300"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        BorderBrush="#303030"
                                                        Background="#10000000">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   Text="No screenshots" />
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="12"
                                                                   Opacity="0.6"
                                                                   Text="Media/Screenshots/" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel IsVisible="{Binding HasProjectScreenshots}"
                                                            Spacing="10">
                                                    <ListBox MaxHeight="112"
                                                             ItemsSource="{Binding ProjectScreenshots}"
                                                             SelectedItem="{Binding SelectedProjectScreenshot}"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProjectScreenshotItem">
                                                                <Border Width="112"
                                                                        Height="82"
                                                                        Margin="2"
                                                                        Padding="3"
                                                                        CornerRadius="4"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#303030">
                                                                    <Image Stretch="UniformToFill"
                                                                           Source="{Binding Image}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <Border Height="440"
                                                            CornerRadius="6"
                                                            BorderThickness="1"
                                                            BorderBrush="#303030"
                                                            Background="#10000000">
                                                        <Image Margin="8"
                                                               Stretch="Uniform"
                                                               Source="{Binding SelectedProjectScreenshotImage}" />
                                                    </Border>

                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <Button Grid.Column="0"
                                                                Width="34"
                                                                IsEnabled="{Binding CanShowPreviousProjectScreenshot}"
                                                                Command="{Binding ShowPreviousProjectScreenshotCommand}"
                                                                Content="‹"
                                                                ToolTip.Tip="Previous screenshot" />
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding SelectedProjectScreenshotName}" />
                                                        <Button Grid.Column="2"
                                                                Width="34"
                                                                IsEnabled="{Binding CanShowNextProjectScreenshot}"
                                                                Command="{Binding ShowNextProjectScreenshotCommand}"
                                                                Content="›"
                                                                ToolTip.Tip="Next screenshot" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer IsVisible="{Binding IsExplorerSidebar}">
                                <StackPanel Margin="32"
                                            MaxWidth="920"
                                            HorizontalAlignment="Left"
                                            Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Text="Files" />
                                        <TextBlock FontSize="14"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Text="Browse the project tree. Project-specific actions appear here for selected folders." />
                                    </StackPanel>

                                    <Border IsVisible="{Binding HasNoSelectedProjectTreeItem}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="Select a file or folder" />
                                            <TextBlock Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="Select Release, Media/Logo or Media/Screenshots to add publishing content directly from the project." />
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding IsSelectedReleaseFolder}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="14">
                                            <TextBlock FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="Release content" />
                                            <TextBlock Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="Create or edit the files used for the project page and the current release." />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="16"
                                                  RowSpacing="10">
                                                <StackPanel Grid.Row="0"
                                                            Spacing="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="Summary" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.65"
                                                               Text="{Binding PublishingSummaryStatus}" />
                                                </StackPanel>
                                                <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Click="OpenPublishingSummary_Click"
                                                        Content="{Binding PublishingSummaryActionText}" />

                                                <StackPanel Grid.Row="1"
                                                            Spacing="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="Description" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.65"
                                                               Text="{Binding PublishingDescriptionStatus}" />
                                                </StackPanel>
                                                <Button Grid.Row="1"
                                                        Grid.Column="1"
                                                        Click="OpenPublishingDescription_Click"
                                                        Content="{Binding PublishingDescriptionActionText}" />

                                                <StackPanel Grid.Row="2"
                                                            Spacing="2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="Changelog" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.65"
                                                               Text="{Binding PublishingChangelogStatus}" />
                                                </StackPanel>
                                                <Button Grid.Row="2"
                                                        Grid.Column="1"
                                                        Click="OpenPublishingChangelog_Click"
                                                        Content="{Binding PublishingChangelogActionText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding IsSelectedLogoFolder}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <StackPanel Spacing="6">
                                                <TextBlock FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Text="Project logo" />
                                                <TextBlock Opacity="0.65"
                                                           TextWrapping="Wrap"
                                                           Text="PNG logo used for the project page." />
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           Text="{Binding PublishingLogoStatus}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Click="ChoosePublishingLogo_Click"
                                                    Content="{Binding PublishingLogoActionText}" />
                                        </Grid>
                                    </Border>

                                    <Border IsVisible="{Binding IsSelectedScreenshotsFolder}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <StackPanel Spacing="7">
                                                <TextBlock FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Text="Screenshots" />
                                                <TextBlock Opacity="0.65"
                                                           TextWrapping="Wrap"
                                                           Text="Add one or more PNG or JPEG screenshots to the project." />
                                                <TextBlock FontSize="12"
                                                           Opacity="0.65"
                                                           Text="{Binding PublishingScreenshotsStatus}" />
                                                <ItemsControl IsVisible="{Binding HasPublishingScreenshots}"
                                                              ItemsSource="{Binding PublishingScreenshots}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,1"
                                                                       FontSize="12"
                                                                       Opacity="0.8"
                                                                       Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Click="AddPublishingScreenshots_Click"
                                                    Content="Add Screenshots" />
                                        </Grid>
                                    </Border>

                                    <Border IsVisible="{Binding HasSelectedGenericProjectTreeItem}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedProjectTreeItemName}" />
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding SelectedProjectTreeItemPath}" />
                                            <TextBlock IsVisible="{Binding HasSelectedMarkdownFile}"
                                                       Margin="0,6,0,0"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       Text="Double-click the Markdown file in the tree to open it in the editor." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid IsVisible="{Binding IsComponentsSidebar}">
                                <TextBlock Margin="32"
                                           Opacity="0.65"
                                           Text="Component workspace" />
                            </Grid>

                            <Grid IsVisible="{Binding IsGitSidebar}">
                                <TextBlock Margin="32"
                                           Opacity="0.65"
                                           Text="Git workspace" />
                            </Grid>

                            <ScrollViewer x:Name="PublishingScrollViewer"
                                          IsVisible="{Binding IsPublishingSidebar}">
                                <StackPanel Margin="32"
                                            HorizontalAlignment="Stretch"
                                            Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Text="Publishing" />
                                        <TextBlock FontSize="14"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Text="Maintain the permanent project page and the changelog for the current release." />
                                    </StackPanel>

                                    <Border IsVisible="{Binding HasNoCurrentProject}"
                                            Padding="20"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <TextBlock Opacity="0.65"
                                                   TextWrapping="Wrap"
                                                   Text="Open a project from Start before editing publishing content." />
                                    </Border>

                                    <StackPanel IsVisible="{Binding HasCurrentProject}"
                                                Spacing="16">
                                        <Border Padding="16"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="18">
                                                <StackPanel Grid.Column="0"
                                                            Spacing="5">
                                                    <TextBlock FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding CurrentProjectName}" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.6"
                                                               TextWrapping="Wrap"
                                                               Text="Summary, Description, Logo and Screenshots belong to the project page. The Changelog belongs to the current .toc version." />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.75"
                                                               Text="{Binding PublishingWorkspaceStatus}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Spacing="8">
                                                    <Button IsEnabled="{Binding CanRevertPublishingWorkspace}"
                                                            Command="{Binding RevertPublishingWorkspaceCommand}"
                                                            Content="Revert" />
                                                    <Button IsEnabled="{Binding CanSavePublishingWorkspace}"
                                                            Command="{Binding SavePublishingWorkspaceCommand}"
                                                            Content="Save All Changes" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="21"
                                                       FontWeight="SemiBold"
                                                       Text="Project Page" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="These contents normally stay valid across multiple addon versions." />
                                        </StackPanel>

                                        <Border x:Name="PublishingSummarySection"
                                                Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="3">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Text="Summary" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Short English-only project summary." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingSummaryFileName}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingSummaryStatus}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBox MinHeight="82"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         Text="{Binding PublishingSummaryText, Mode=TwoWay}"
                                                         Watermark="English project summary ..." />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="PublishingDescriptionSection"
                                                Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="3">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Text="Description" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Markdown description. English first; additional language sections may follow." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingDescriptionFileName}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingDescriptionStatus}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid MinHeight="440"
                                                      ColumnDefinitions="*,4,*">
                                                    <TextBox Grid.Column="0"
                                                             Margin="0,0,10,0"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             TextWrapping="NoWrap"
                                                             FontFamily="Consolas"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding PublishingDescriptionText, Mode=TwoWay}" />

                                                    <GridSplitter Grid.Column="1"
                                                                  ResizeDirection="Columns"
                                                                  Background="#2A2A2A" />

                                                    <Border Grid.Column="2"
                                                            Margin="10,0,0,0"
                                                            Padding="10"
                                                            BorderThickness="1"
                                                            BorderBrush="#303030">
                                                        <md:MarkdownScrollViewer Markdown="{Binding PublishingDescriptionText}"
                                                                                 SelectionEnabled="True"
                                                                                 SaveScrollValueWhenContentUpdated="True" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="PublishingMediaSection"
                                                   Margin="0,8,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="Media" />

                                        <Border Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <Grid ColumnDefinitions="180,*,Auto"
                                                  ColumnSpacing="18">
                                                <Border Grid.Column="0"
                                                        Width="160"
                                                        Height="160"
                                                        CornerRadius="8"
                                                        BorderThickness="1"
                                                        BorderBrush="#303030"
                                                        ClipToBounds="True"
                                                        Background="#10000000">
                                                    <Grid>
                                                        <Image IsVisible="{Binding HasCurrentProjectLogoImage}"
                                                               Margin="6"
                                                               Stretch="Uniform"
                                                               Source="{Binding CurrentProjectLogoImage}" />
                                                        <TextBlock IsVisible="{Binding HasNoCurrentProjectLogoImage}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Opacity="0.6"
                                                                   Text="No logo" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="6">
                                                    <TextBlock FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Text="Logo" />
                                                    <TextBlock Opacity="0.7"
                                                               TextWrapping="Wrap"
                                                               Text="CurseForge project logo. PNG is used as the canonical project logo." />
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="12"
                                                               Opacity="0.65"
                                                               Text="Media/Logo/logo.png" />
                                                    <TextBlock FontSize="12"
                                                               Opacity="0.65"
                                                               Text="{Binding PublishingLogoStatus}" />
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Click="ChoosePublishingLogo_Click"
                                                        Content="{Binding PublishingLogoActionText}" />
                                            </Grid>
                                        </Border>

                                        <Border Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="16">
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="5">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Text="Screenshots" />
                                                        <TextBlock Opacity="0.7"
                                                                   TextWrapping="Wrap"
                                                                   Text="Screenshots for the project page. Multiple PNG or JPEG images can be added at once." />
                                                        <TextBlock FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Media/Screenshots/" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="{Binding PublishingScreenshotsStatus}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Click="AddPublishingScreenshots_Click"
                                                            Content="Add Screenshots" />
                                                </Grid>

                                                <Border IsVisible="{Binding HasNoProjectScreenshots}"
                                                        MinHeight="120"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        BorderBrush="#303030"
                                                        Background="#10000000">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.6"
                                                               Text="No screenshots" />
                                                </Border>

                                                <ItemsControl IsVisible="{Binding HasProjectScreenshots}"
                                                              ItemsSource="{Binding ProjectScreenshots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProjectScreenshotItem">
                                                            <Border Width="230"
                                                                    Height="160"
                                                                    Margin="0,0,12,12"
                                                                    CornerRadius="6"
                                                                    BorderThickness="1"
                                                                    BorderBrush="#303030"
                                                                    ClipToBounds="True"
                                                                    Background="#10000000">
                                                                <Grid>
                                                                    <Image Stretch="UniformToFill"
                                                                           Source="{Binding Image}" />

                                                                    <Button Width="30"
                                                                            Height="30"
                                                                            Margin="6"
                                                                            Padding="0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Click="RemovePublishingScreenshot_Click"
                                                                            Content="🗑"
                                                                            ToolTip.Tip="Remove screenshot" />

                                                                    <Border VerticalAlignment="Bottom"
                                                                            Padding="6,4"
                                                                            Background="#C0000000">
                                                                        <TextBlock FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Text="{Binding FileName}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel x:Name="PublishingCurrentReleaseSection"
                                                    Margin="0,12,0,0"
                                                    Spacing="4">
                                            <TextBlock FontSize="21"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding CurrentReleaseTitle}" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Text="The release version comes from the primary addon's .toc file. Each version keeps its own changelog." />
                                        </StackPanel>

                                        <Border IsVisible="{Binding HasNoCurrentReleaseVersion}"
                                                Padding="16"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <TextBlock Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       Text="No valid .toc version is available. Add a version before editing the release changelog." />
                                        </Border>

                                        <Border IsVisible="{Binding HasCurrentReleaseVersion}"
                                                Padding="18"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0"
                                                                Spacing="3">
                                                        <TextBlock FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Text="Changelog" />
                                                        <TextBlock FontSize="12"
                                                                   Opacity="0.65"
                                                                   Text="Markdown changelog for this release only." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingChangelogFileName}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="11"
                                                                   Opacity="0.6"
                                                                   Text="{Binding PublishingChangelogStatus}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid MinHeight="340"
                                                      ColumnDefinitions="*,4,*">
                                                    <TextBox Grid.Column="0"
                                                             Margin="0,0,10,0"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             TextWrapping="NoWrap"
                                                             FontFamily="Consolas"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             Text="{Binding PublishingChangelogText, Mode=TwoWay}" />

                                                    <GridSplitter Grid.Column="1"
                                                                  ResizeDirection="Columns"
                                                                  Background="#2A2A2A" />

                                                    <Border Grid.Column="2"
                                                            Margin="10,0,0,0"
                                                            Padding="10"
                                                            BorderThickness="1"
                                                            BorderBrush="#303030">
                                                        <md:MarkdownScrollViewer Markdown="{Binding PublishingChangelogText}"
                                                                                 SelectionEnabled="True"
                                                                                 SaveScrollValueWhenContentUpdated="True" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer IsVisible="{Binding IsCurseForgeSidebar}">
                                <StackPanel Margin="32"
                                            MaxWidth="920"
                                            HorizontalAlignment="Left"
                                            Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Text="CurseForge" />
                                        <TextBlock FontSize="14"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   Text="Maintain the local CurseForge project settings for the current addon. Nothing is sent to CurseForge yet." />
                                    </StackPanel>

                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <StackPanel Spacing="5">
                                                <TextBlock FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="Data source" />
                                                <TextBlock Opacity="0.7"
                                                           Text="{Binding CurseForgeDataSourceStatus}" />
                                                <TextBlock FontSize="12"
                                                           Opacity="0.6"
                                                           TextWrapping="Wrap"
                                                           Text="CurseForge-specific project settings are available only after a successful connection. Configure the API key in Settings." />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsCurseForgeDataSourceConfigured}"
                                                    Command="{Binding TestCurseForgeDataSourceCommand}"
                                                    Content="Connect / Refresh" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A"
                                            IsEnabled="{Binding CanUseCurseForgeProjectSettings}">
                                        <StackPanel Spacing="14">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="16">
                                                <StackPanel Grid.Column="0"
                                                            Spacing="4">
                                                    <TextBlock FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Text="Project binding" />
                                                    <TextBlock Opacity="0.7"
                                                               Text="{Binding CurseForgeBindingStatus}" />
                                                    <TextBlock FontSize="11"
                                                               Opacity="0.6"
                                                               TextWrapping="Wrap"
                                                               Text="Enter either the CurseForge Project ID or slug. The Studio resolves the project against the live CurseForge API." />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanLoadCurseForgeProject}"
                                                        Command="{Binding LoadCurseForgeProjectCommand}"
                                                        Content="Load Project" />
                                            </Grid>

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="180,*"
                                                  ColumnSpacing="18"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0"
                                                           FontWeight="SemiBold"
                                                           Text="Local project" />
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeProjectName}" />

                                                <TextBlock Grid.Row="1"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Project ID" />
                                                <TextBox Grid.Row="1"
                                                         Grid.Column="1"
                                                         Text="{Binding CurseForgeProjectId}"
                                                         Watermark="e.g. 1234567" />

                                                <TextBlock Grid.Row="2"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Slug" />
                                                <TextBox Grid.Row="2"
                                                         Grid.Column="1"
                                                         Text="{Binding CurseForgeSlug}"
                                                         Watermark="e.g. foreverbag" />

                                                <TextBlock Grid.Row="3"
                                                           Text="CurseForge name" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeRemoteProjectName}" />

                                                <TextBlock Grid.Row="4"
                                                           Text="CurseForge slug" />
                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeRemoteProjectSlug}" />

                                                <TextBlock Grid.Row="5"
                                                           Text="Project status" />
                                                <TextBlock Grid.Row="5"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeRemoteProjectStatus}" />

                                                <TextBlock Grid.Row="6"
                                                           Text="Remote main category" />
                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeRemoteMainCategory}" />

                                                <TextBlock Grid.Row="7"
                                                           Text="Categories" />
                                                <TextBlock Grid.Row="7"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeCategoryComparisonStatus}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A"
                                            IsEnabled="{Binding CanUseCurseForgeProjectSettings}">
                                        <StackPanel Spacing="14">
                                            <TextBlock FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Text="Classification" />

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="180,*"
                                                  ColumnSpacing="18"
                                                  RowSpacing="12">
                                                <TextBlock Grid.Row="0"
                                                           VerticalAlignment="Top"
                                                           Margin="0,7,0,0"
                                                           FontWeight="SemiBold"
                                                           Text="Main category" />
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Spacing="6">
                                                    <TextBox Text="{Binding CurseForgeMainCategorySearchText}"
                                                             Watermark="Filter categories ..." />
                                                    <ComboBox ItemsSource="{Binding FilteredCurseForgeMainCategories}"
                                                              SelectedItem="{Binding SelectedCurseForgeMainCategory}"
                                                              PlaceholderText="Select a CurseForge category">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CurseForgeCategoryChoice">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1"
                                                           VerticalAlignment="Top"
                                                           Margin="0,7,0,0"
                                                           FontWeight="SemiBold"
                                                           Text="Additional categories" />
                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="1"
                                                            Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding CurseForgeAdditionalCategorySearchText}"
                                                                 Watermark="Filter additional categories ..." />
                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Opacity="0.7"
                                                                   Text="{Binding CurseForgeAdditionalCategorySelectionStatus}" />
                                                    </Grid>
                                                    <Border MaxHeight="230"
                                                            Padding="8"
                                                            BorderThickness="1"
                                                            BorderBrush="#303030">
                                                        <ScrollViewer>
                                                            <ItemsControl ItemsSource="{Binding FilteredCurseForgeAdditionalCategories}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CurseForgeCategoryChoice">
                                                                        <CheckBox Margin="0,2"
                                                                                  Content="{Binding Name}"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  IsEnabled="{Binding CanSelectAdditional}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                    <TextBlock FontSize="11"
                                                               Opacity="0.6"
                                                               TextWrapping="Wrap"
                                                               Text="Select up to four additional categories. The selected main category is excluded automatically." />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="Project license" />
                                                <TextBox Grid.Row="2"
                                                         Grid.Column="1"
                                                         Text="{Binding CurseForgeLicense}"
                                                         Watermark="e.g. GPL-3.0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A"
                                            IsEnabled="{Binding CanUseCurseForgeProjectSettings}">
                                        <Grid ColumnDefinitions="180,*"
                                              ColumnSpacing="18">
                                            <StackPanel>
                                                <TextBlock FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="Distribution" />
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           TextWrapping="Wrap"
                                                           Text="Controls whether third-party services may distribute project information and files." />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding CurseForgeDistributionOptions}"
                                                      SelectedItem="{Binding CurseForgeDistributionSelection}" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="18"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="Publishing readiness" />
                                                <TextBlock Opacity="0.75"
                                                           Text="{Binding CurseForgePublishingReadiness}" />
                                            </StackPanel>

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="180,*"
                                                  ColumnSpacing="18"
                                                  RowSpacing="8">
                                                <TextBlock Grid.Row="0"
                                                           Text="CurseForge project" />
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessBinding}" />

                                                <TextBlock Grid.Row="1"
                                                           Text="Summary" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessSummary}" />

                                                <TextBlock Grid.Row="2"
                                                           Text="Description" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessDescription}" />

                                                <TextBlock Grid.Row="3"
                                                           Text="Logo" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessLogo}" />

                                                <TextBlock Grid.Row="4"
                                                           Text="Screenshots" />
                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeScreenshotsStatus}" />

                                                <TextBlock Grid.Row="5"
                                                           Text=".toc version" />
                                                <TextBlock Grid.Row="5"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessVersion}" />

                                                <TextBlock Grid.Row="6"
                                                           Text="Release changelog" />
                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessChangelog}" />

                                                <TextBlock Grid.Row="7"
                                                           Text="Main category" />
                                                <TextBlock Grid.Row="7"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessMainCategory}" />

                                                <TextBlock Grid.Row="8"
                                                           Text="License" />
                                                <TextBlock Grid.Row="8"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessLicense}" />

                                                <TextBlock Grid.Row="9"
                                                           Text="Distribution" />
                                                <TextBlock Grid.Row="9"
                                                           Grid.Column="1"
                                                           Text="{Binding CurseForgeReadinessDistribution}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Button HorizontalAlignment="Left"
                                            IsEnabled="{Binding CanUseCurseForgeProjectSettings}"
                                            Command="{Binding SaveCurseForgeSettingsCommand}"
                                            Content="Save CurseForge Settings" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding ActionTabTitle}"
                             IsVisible="{Binding HasActionTab}">
                        <Grid Margin="26">
                            <Border IsVisible="{Binding IsCreateAddonAction}"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Padding="22"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#3A3A3A">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Text="Create New Addon" />
                                        <Button Grid.Column="1"
                                                Command="{Binding CloseActionTabCommand}"
                                                Content="×"
                                                ToolTip.Tip="Close tab" />
                                    </Grid>

                                    <TextBlock Text="Addon name" />
                                    <TextBox Text="{Binding NewAddonName}"
                                             PlaceholderText="e.g. MyAddon" />

                                    <TextBlock Text="Project root" />
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding ProjectRoot}" />

                                    <Button HorizontalAlignment="Left"
                                            Click="CreateAddon_Click"
                                            Content="Create Addon" />
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding IsImportAddonAction}"
                                    MaxWidth="720"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Padding="22"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#3A3A3A">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Text="Import Existing Addon" />
                                        <Button Grid.Column="1"
                                                Command="{Binding CloseActionTabCommand}"
                                                Content="×"
                                                ToolTip.Tip="Close tab" />
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap"
                                               Opacity="0.7"
                                               Text="Only detected runtime addon folders are copied into the Studio project. Documentation, publishing files and media stay in the source and can be migrated separately. The original source remains unchanged." />

                                    <TextBlock Text="Source" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBox Grid.Column="0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ImportSourceDirectory}"
                                                 PlaceholderText="Select addon folder ..." />
                                        <Button Grid.Column="1"
                                                Click="ChooseImportSource_Click"
                                                Content="Browse ..." />
                                    </Grid>

                                    <TextBlock Text="Project root" />
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding ProjectRoot}" />

                                    <Button HorizontalAlignment="Left"
                                            Click="ImportAddon_Click"
                                            Content="Copy and Normalize Addon" />
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding IsImportCollectorAction}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="22"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#3A3A3A">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                                      RowSpacing="14">
                                    <Grid Grid.Row="0"
                                          ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Text="Import Collector Data" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding CloseActionTabCommand}"
                                                    Content="×"
                                                    ToolTip.Tip="Close tab" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   MaxWidth="880"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   Text="Read PallandoDataCollector SavedVariables without executing Lua. The import validates the collector format and shows the observed WoW client, APIs, events and maps. Nothing is published automatically." />

                                        <StackPanel Grid.Row="2"
                                                    Spacing="6">
                                            <TextBlock Text="SavedVariables file" />
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBox Grid.Column="0"
                                                         MinWidth="620"
                                                         IsReadOnly="True"
                                                         Text="{Binding CollectorSourceFile}"
                                                         PlaceholderText="Select PallandoDataCollector.lua ..." />
                                                <Button Grid.Column="1"
                                                        Click="ChooseCollectorSource_Click"
                                                        Content="Browse ..." />
                                            </Grid>
                                        </StackPanel>

                                        <Button Grid.Row="3"
                                                HorizontalAlignment="Left"
                                                Click="ImportCollector_Click"
                                                Content="Read Collector Data" />

                                        <Border Grid.Row="4"
                                                IsVisible="{Binding HasCollectorImport}"
                                                Padding="14"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="#3A3A3A">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                                                  RowSpacing="10">
                                                <TextBlock Grid.Row="0"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="Imported Collector Snapshot" />
                                                <TextBlock Grid.Row="1"
                                                           FontFamily="Consolas"
                                                           Text="{Binding CollectorClientSummary}" />
                                                <TextBlock Grid.Row="2"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           Text="{Binding CollectorRunSummary}" />

                                                <Border Grid.Row="3"
                                                        Padding="10"
                                                        CornerRadius="4"
                                                        BorderThickness="1"
                                                        BorderBrush="#3A3A3A">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="Validation" />
                                                        <TextBlock TextWrapping="Wrap"
                                                                   Text="{Binding CollectorValidationSummary}" />
                                                        <ItemsControl IsVisible="{Binding HasCollectorValidationIssues}"
                                                                      ItemsSource="{Binding CollectorValidationIssues}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CollectorValidationIssueRow">
                                                                    <Grid ColumnDefinitions="70,75,*"
                                                                          ColumnSpacing="8"
                                                                          Margin="0,2">
                                                                        <TextBlock Text="{Binding Severity}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   FontFamily="Consolas"
                                                                                   Text="{Binding Code}" />
                                                                        <TextBlock Grid.Column="2"
                                                                                   TextWrapping="Wrap"
                                                                                   Text="{Binding Message}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <TabControl Grid.Row="4"
                                                            VerticalAlignment="Stretch">
                                                    <TabItem Header="APIs">
                                                        <Grid RowDefinitions="Auto,*"
                                                              Margin="0,10,0,0"
                                                              RowSpacing="6">
                                                            <Grid ColumnDefinitions="2.4*,110,100,90,110"
                                                                  ColumnSpacing="8">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="API" />
                                                                <TextBlock Grid.Column="1"
                                                                           FontWeight="SemiBold"
                                                                           Text="Status" />
                                                                <TextBlock Grid.Column="2"
                                                                           FontWeight="SemiBold"
                                                                           Text="Type" />
                                                                <TextBlock Grid.Column="3"
                                                                           FontWeight="SemiBold"
                                                                           Text="Count" />
                                                                <TextBlock Grid.Column="4"
                                                                           FontWeight="SemiBold"
                                                                           Text="Builds" />
                                                            </Grid>
                                                            <ListBox Grid.Row="1"
                                                                     ItemsSource="{Binding CollectorApis}"
                                                                     ClipToBounds="True"
                                                                     ScrollViewer.VerticalSnapPointsType="MandatorySingle"
                                                                     ScrollViewer.VerticalSnapPointsAlignment="Near">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CollectorApiRow">
                                                                        <Grid ColumnDefinitions="2.4*,110,100,90,110"
                                                                              ColumnSpacing="8"
                                                                              Margin="0,3">
                                                                            <TextBlock Text="{Binding Key}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Availability}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding ValueType}" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding Observations}" />
                                                                            <TextBlock Grid.Column="4"
                                                                                       Text="{Binding Builds}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                    </TabItem>

                                                    <TabItem Header="Events">
                                                        <Grid RowDefinitions="Auto,*"
                                                              Margin="0,10,0,0"
                                                              RowSpacing="6">
                                                            <Grid ColumnDefinitions="2.4*,110,90,90,110"
                                                                  ColumnSpacing="8">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="Event" />
                                                                <TextBlock Grid.Column="1"
                                                                           FontWeight="SemiBold"
                                                                           Text="Support" />
                                                                <TextBlock Grid.Column="2"
                                                                           FontWeight="SemiBold"
                                                                           Text="Observed" />
                                                                <TextBlock Grid.Column="3"
                                                                           FontWeight="SemiBold"
                                                                           Text="Count" />
                                                                <TextBlock Grid.Column="4"
                                                                           FontWeight="SemiBold"
                                                                           Text="Builds" />
                                                            </Grid>
                                                            <ListBox Grid.Row="1"
                                                                     ItemsSource="{Binding CollectorEvents}"
                                                                     ClipToBounds="True"
                                                                     ScrollViewer.VerticalSnapPointsType="MandatorySingle"
                                                                     ScrollViewer.VerticalSnapPointsAlignment="Near">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CollectorEventRow">
                                                                        <Grid ColumnDefinitions="2.4*,110,90,90,110"
                                                                              ColumnSpacing="8"
                                                                              Margin="0,3">
                                                                            <TextBlock Text="{Binding Key}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Support}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding Observed}" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding Observations}" />
                                                                            <TextBlock Grid.Column="4"
                                                                                       Text="{Binding Builds}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                    </TabItem>

                                                    <TabItem Header="Maps">
                                                        <Grid RowDefinitions="Auto,*"
                                                              Margin="0,10,0,0"
                                                              RowSpacing="6">
                                                            <Grid ColumnDefinitions="75,2*,80,90,150,80,110"
                                                                  ColumnSpacing="8">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="ID" />
                                                                <TextBlock Grid.Column="1"
                                                                           FontWeight="SemiBold"
                                                                           Text="Name" />
                                                                <TextBlock Grid.Column="2"
                                                                           FontWeight="SemiBold"
                                                                           Text="Type" />
                                                                <TextBlock Grid.Column="3"
                                                                           FontWeight="SemiBold"
                                                                           Text="Parent" />
                                                                <TextBlock Grid.Column="4"
                                                                           FontWeight="SemiBold"
                                                                           Text="World size" />
                                                                <TextBlock Grid.Column="5"
                                                                           FontWeight="SemiBold"
                                                                           Text="Count" />
                                                                <TextBlock Grid.Column="6"
                                                                           FontWeight="SemiBold"
                                                                           Text="Builds" />
                                                            </Grid>
                                                            <ListBox Grid.Row="1"
                                                                     ItemsSource="{Binding CollectorMaps}"
                                                                     ClipToBounds="True"
                                                                     ScrollViewer.VerticalSnapPointsType="MandatorySingle"
                                                                     ScrollViewer.VerticalSnapPointsAlignment="Near">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CollectorMapRow">
                                                                        <Grid ColumnDefinitions="75,2*,80,90,150,80,110"
                                                                              ColumnSpacing="8"
                                                                              Margin="0,3">
                                                                            <TextBlock Text="{Binding Id}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Name}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding Type}" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding Parent}" />
                                                                            <TextBlock Grid.Column="4"
                                                                                       Text="{Binding Size}" />
                                                                            <TextBlock Grid.Column="5"
                                                                                       Text="{Binding Observations}" />
                                                                            <TextBlock Grid.Column="6"
                                                                                       Text="{Binding Builds}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                    </TabItem>
                                                </TabControl>
                                            </Grid>
                                        </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding MarkdownDocumentTabTitle}"
                             IsVisible="{Binding HasMarkdownDocument}">
                        <Grid RowDefinitions="82,*">
                            <Border Grid.Row="0"
                                    Padding="12,6"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="#353535">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="6">
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding MarkdownDocumentName}" />
                                        <TextBlock FontSize="11"
                                                   Opacity="0.55"
                                                   Text="{Binding MarkdownDocumentPath}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Command="{Binding ShowMarkdownEditorCommand}"
                                                Content="Editor" />
                                        <Button Command="{Binding ShowMarkdownPreviewCommand}"
                                                Content="Preview" />
                                        <Button Command="{Binding ShowMarkdownSplitCommand}"
                                                Content="Split" />
                                        <Button IsEnabled="{Binding IsMarkdownDirty}"
                                                Command="{Binding SaveMarkdownDocumentCommand}"
                                                Content="Save" />
                                        <Button IsEnabled="{Binding IsMarkdownDirty}"
                                                Command="{Binding RevertMarkdownDocumentCommand}"
                                                Content="Revert" />
                                        <Button IsEnabled="{Binding CanCloseMarkdownDocument}"
                                                Command="{Binding CloseMarkdownDocumentCommand}"
                                                Content="×"
                                                ToolTip.Tip="Close document" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding IsMarkdownEditingMode}"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownHeading1_Click"
                                                Content="H1"
                                                ToolTip.Tip="Heading 1" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownHeading2_Click"
                                                Content="H2"
                                                ToolTip.Tip="Heading 2" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownHeading3_Click"
                                                Content="H3"
                                                ToolTip.Tip="Heading 3" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownHeading4_Click"
                                                Content="H4"
                                                ToolTip.Tip="Heading 4" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownBold_Click"
                                                Content="B"
                                                FontWeight="Bold"
                                                ToolTip.Tip="Bold" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownItalic_Click"
                                                Content="I"
                                                FontStyle="Italic"
                                                ToolTip.Tip="Italic" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownStrike_Click"
                                                Content="S"
                                                ToolTip.Tip="Strikethrough" />
                                        <Separator Margin="4,0"
                                                   Width="1" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownLink_Click"
                                                Content="Link"
                                                ToolTip.Tip="Link" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownCode_Click"
                                                Content="&lt;/&gt;"
                                                ToolTip.Tip="Inline code" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownImage_Click"
                                                Content="Img"
                                                ToolTip.Tip="Image" />
                                        <Separator Margin="4,0"
                                                   Width="1" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownNumberedList_Click"
                                                Content="1≡"
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                ToolTip.Tip="Numbered list" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownBulletList_Click"
                                                Content="•≡"
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                ToolTip.Tip="Bulleted list" />
                                        <Button Width="40"
                                                Height="30"
                                                Padding="3"
                                                Click="MarkdownQuote_Click"
                                                Content="&gt;"
                                                ToolTip.Tip="Quote" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <TextBox x:Name="MarkdownEditorTextBox"
                                         IsVisible="{Binding IsMarkdownEditorMode}"
                                         Margin="12"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Text="{Binding MarkdownText, Mode=TwoWay}" />

                                <Border IsVisible="{Binding IsMarkdownPreviewMode}"
                                        Padding="18">
                                    <md:MarkdownScrollViewer Markdown="{Binding MarkdownText}"
                                                             SelectionEnabled="True"
                                                             SaveScrollValueWhenContentUpdated="True">
                                        <md:MarkdownScrollViewer.Styles>
                                            <Style Selector="ctxt|CTextBlock.ListMarker">
                                                <Setter Property="FontSize"
                                                        Value="10" />
                                                <Setter Property="Margin"
                                                        Value="0,4,7,4" />
                                            </Style>
                                        </md:MarkdownScrollViewer.Styles>
                                    </md:MarkdownScrollViewer>
                                </Border>

                                <Grid IsVisible="{Binding IsMarkdownSplitMode}"
                                      ColumnDefinitions="*,4,*">
                                    <TextBox x:Name="MarkdownSplitEditorTextBox"
                                             Grid.Column="0"
                                             Margin="12"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             TextWrapping="NoWrap"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             Text="{Binding MarkdownText, Mode=TwoWay}" />

                                    <GridSplitter Grid.Column="1"
                                                  ResizeDirection="Columns"
                                                  Background="#2A2A2A" />

                                    <Border Grid.Column="2"
                                            Padding="18">
                                        <md:MarkdownScrollViewer x:Name="MarkdownSplitPreview"
                                                                 Markdown="{Binding MarkdownText}"
                                                                 SelectionEnabled="True"
                                                                 SaveScrollValueWhenContentUpdated="True">
                                            <md:MarkdownScrollViewer.Styles>
                                                <Style Selector="ctxt|CTextBlock.ListMarker">
                                                    <Setter Property="FontSize"
                                                            Value="10" />
                                                    <Setter Property="Margin"
                                                            Value="0,4,7,4" />
                                                </Style>
                                            </md:MarkdownScrollViewer.Styles>
                                        </md:MarkdownScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1"
                              ResizeDirection="Rows"
                              Background="#2A2A2A" />

                <TabControl Grid.Row="2">
                    <TabItem Header="PROBLEMS">
                        <TextBlock Margin="14"
                                   Opacity="0.6"
                                   Text="No problems." />
                    </TabItem>
                    <TabItem Header="OUTPUT">
                        <TextBlock Margin="14"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}" />
                    </TabItem>
                    <TabItem Header="QA">
                        <TextBlock Margin="14"
                                   Opacity="0.6"
                                   Text="QA checks will appear here." />
                    </TabItem>
                    <TabItem Header="DEPLOY">
                        <TextBlock Margin="14"
                                   Opacity="0.6"
                                   Text="WoW Forever deployment will be logged here." />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,0"
                BorderThickness="0,1,0,0"
                BorderBrush="#353535">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="18">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.7"
                           Text="WoW Forever" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.7"
                           Text="Studio" />
            </Grid>
        </Border>
    </Grid>
</Window>
